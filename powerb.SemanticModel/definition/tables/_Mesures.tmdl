/// Table technique vide servant uniquement de conteneur pour les mesures DAX du dashboard (bonne pratique de modélisation).
table _Mesures
	isHidden
	lineageTag: 1a6203b4-107e-4e4b-ba9b-399efee87e7e

	/// Nombre de clients distincts ayant commandé sur la période filtrée.
	measure 'Nb Clients' = DISTINCTCOUNT(fact_vente[id_client])
		formatString: #,##0
		displayFolder: 01 Activité
		lineageTag: d986fc33-be65-57ad-bfb9-81f9e0d94f92

	/// Commandes dont statut_commande = "Livrée".
	measure 'Nb Commandes Livrees' = CALCULATE(COUNTROWS(fact_vente), fact_vente[statut_commande] = "Livrée")
		formatString: #,##0
		displayFolder: 01 Activité
		lineageTag: bfed86d0-9ec2-598b-92c4-688fdbbbe45d

	/// Volume de lignes de commande sur la période filtrée.
	measure 'Nb Commandes' = COUNTROWS(fact_vente)
		formatString: #,##0
		displayFolder: 01 Activité
		lineageTag: cb4f1a43-b97f-5cd7-912e-373117be9c39

	/// Chiffre d'affaires net : montant des commandes hors annulées et retournées (TND).
	measure 'CA Total' = CALCULATE(SUM(fact_vente[montant]), NOT(fact_vente[statut_commande] IN {"Annulée", "Retournée"}))
		formatString: #,##0.00
		displayFolder: 01 Activité
		lineageTag: 2b873ae3-3bea-57d4-abae-5d2a8982c6e5

	/// CA net rapporté à l'objectif mensuel cumulé des boutiques filtrées, multiplié par le nombre de mois de la période.
	measure '% Objectif Boutique' = VAR nbMois = MAX(1, COUNTROWS(SUMMARIZE(fact_vente, dim_temps[annee], dim_temps[mois]))) RETURN DIVIDE([CA Total], SUM(dim_boutique[objectif_mensuel]) * nbMois, 0)
		formatString: 0.0%
		displayFolder: 01 Activité
		lineageTag: 12ab0be9-7ca3-5afc-a0c4-62abc1c6750e

	/// CA net moyen par client actif.
	measure 'CA Moyen Client' = DIVIDE([CA Total], [Nb Clients], 0)
		formatString: #,##0.00
		displayFolder: 02 Rentabilité
		lineageTag: 3d0c9ec0-0709-5736-9358-0ddcd09a36bc

	/// CA net moins coût d'achat des produits vendus (TND).
	measure 'Marge Brute' = [CA Total] - CALCULATE(SUM(fact_vente[cout_total]), NOT(fact_vente[statut_commande] IN {"Annulée", "Retournée"}))
		formatString: #,##0.00
		displayFolder: 02 Rentabilité
		lineageTag: b00bba01-90e9-5c28-ba18-8e97c4d10fbd

	/// Marge brute / CA net.
	measure 'Taux Marge' = DIVIDE([Marge Brute], [CA Total], 0)
		formatString: 0.0%
		displayFolder: 02 Rentabilité
		lineageTag: 9e9fa9ad-e84d-5b89-98b0-143990597525

	/// CA net divisé par le nombre de commandes valides.
	measure 'Panier Moyen' = DIVIDE([CA Total], CALCULATE(COUNTROWS(fact_vente), NOT(fact_vente[statut_commande] IN {"Annulée", "Retournée"})), 0)
		formatString: #,##0.00
		displayFolder: 02 Rentabilité
		lineageTag: 259a53a4-2069-55c2-ad44-76b1a3e06f8a

	/// Remises accordées / prix catalogue.
	measure 'Taux Remise Moyen' = DIVIDE(SUM(fact_vente[remise]), SUM(fact_vente[montant]) + SUM(fact_vente[remise]), 0)
		formatString: 0.0%
		displayFolder: 02 Rentabilité
		lineageTag: 89f4bedd-c42a-52b7-9c73-770c36e063b9

	/// Part des commandes retournées.
	measure 'Taux Retour' = DIVIDE(CALCULATE(COUNTROWS(fact_vente), fact_vente[retour] = 1), COUNTROWS(fact_vente), 0)
		formatString: 0.0%
		displayFolder: 03 Retours & Qualité
		lineageTag: 10e7a59f-3102-58cf-90f0-a1a9b2cd354a

	/// Montant des commandes dont score_risque_retour >= 70 (même seuil que Statut_Risque_Retour = Élevé).
	measure 'CA Expose Retours' = CALCULATE(SUM(fact_vente[montant]), fact_vente[score_risque_retour] >= 70)
		formatString: #,##0.00
		displayFolder: 03 Retours & Qualité
		lineageTag: e15ae918-8859-5a7b-89b9-a224acde647d

	/// Commandes dont statut_commande = "Annulée".
	measure 'Nb Commandes Annulees' = CALCULATE(COUNTROWS(fact_vente), fact_vente[statut_commande] = "Annulée")
		formatString: #,##0
		displayFolder: 03 Retours & Qualité
		lineageTag: 287f1b80-e21a-5887-a9eb-1cb3d4c1d0d2

	/// Score de risque de retour moyen des commandes filtrées.
	measure 'Score Risque Retour Moyen' = AVERAGE(fact_vente[score_risque_retour])
		formatString: 0.0
		displayFolder: 03 Retours & Qualité
		lineageTag: 7c026233-af1f-5264-9c3b-23f963d10bed

	/// Note de satisfaction moyenne (1 à 5).
	measure 'Note Client Moyenne' = AVERAGE(fact_vente[note_client])
		formatString: 0.00
		displayFolder: 03 Retours & Qualité
		lineageTag: 311a5897-9221-5fc4-9fd6-b898ce03e4a3

	/// Clients sans commande depuis plus de 90 jours (comprend ceux qui n'ont jamais commandé).
	measure 'Clients Inactifs 90j' = VAR DateRef = CALCULATE(MAX(fact_vente[date]), ALL(fact_vente)) RETURN CALCULATE(DISTINCTCOUNT(dim_client[id_client]), FILTER(dim_client, ISBLANK(dim_client[derniere_commande]) || DATEDIFF(dim_client[derniere_commande], DateRef, DAY) > 90))
		formatString: #,##0
		displayFolder: 03 Retours & Qualité
		lineageTag: d6bcd6c5-ff3e-5451-8249-8a0d710af95e

	column Colonne1
		lineageTag: 2dd6cfe0-a905-4241-a8fe-87723dc0c777
		isNameInferred
		sourceColumn: [Colonne1]

	partition _Mesures = calculated
		mode: import
		source = ROW("Colonne1", 0)

