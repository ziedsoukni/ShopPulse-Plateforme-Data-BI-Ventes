	/// Heure de la transaction en entier (0-23), extraite de la colonne texte 'heure' (stockée en VARCHAR HH:MM:SS côté ETL). Utilisée pour la carte de chaleur heure x jour de la semaine.
	column Heure_Entiere = VALUE(LEFT('dwh fact_transaction'[heure], 2))
		dataType: int64
		formatString: 0
		displayFolder: Colonnes calculées
		lineageTag: f46438ec-ec45-4a53-b712-b518dd4d2799
		summarizeBy: none

	/// Statut de risque lisible (Faible/Moyen/Élevé) dérivé de risque_transaction. Seuils 40 et 70 à valider avec le métier (voir spec client, section 3.3).
	column Statut_Risque = SWITCH(TRUE(), 'dwh fact_transaction'[risque_transaction] < 40, "Faible", 'dwh fact_transaction'[risque_transaction] < 70, "Moyen", "Élevé")
		dataType: string
		displayFolder: Colonnes calculées
		lineageTag: 2425e5e2-0be4-43b5-aba7-ac08fddf9f19
		summarizeBy: none

	partition 'dwh fact_transaction' = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database("localhost", "PFEE"),
				    dwh_fact_transaction = Source{[Schema="dwh",Item="fact_transaction"]}[Data]
				in
				    dwh_fact_transaction

	annotation PBI_ResultType = Table

