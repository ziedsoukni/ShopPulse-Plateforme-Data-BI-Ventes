				    Types = Table.TransformColumnTypes(Entetes, {{"id_vente", type text}, {"date", type date}, {"heure", type text}, {"id_client", type text}, {"id_boutique", type text}, {"id_produit", type text}, {"sk_date", Int64.Type}, {"canal", type text}, {"quantite", Int64.Type}, {"montant", type number}, {"remise", type number}, {"cout_total", type number}, {"frais_livraison", type number}, {"statut_commande", type text}, {"moyen_paiement", type text}, {"mode_livraison", type text}, {"delai_livraison", Int64.Type}, {"motif_annulation", type text}, {"note_client", Int64.Type}, {"score_risque_retour", Int64.Type}, {"retour", Int64.Type}}, "en-US")
				in
				    Types

	annotation PBI_ResultType = Table

