	/// Heure de la commande en entier (0-23), extraite de la colonne texte 'heure' (HH:MM:SS). Utilisée pour la carte de chaleur / le graphique par heure.
	column Heure_Entiere = VALUE(LEFT(fact_vente[heure], 2))
		dataType: int64
		formatString: 0
		displayFolder: Colonnes calculées
		lineageTag: a979ab5c-54df-548a-b1be-5650a1947183
		summarizeBy: none

	/// Niveau de risque de retour lisible (Faible/Moyen/Élevé) dérivé de score_risque_retour. Seuils 40 et 70 (à ajuster avec le métier).
	column Statut_Risque_Retour = SWITCH(TRUE(), fact_vente[score_risque_retour] < 40, "Faible", fact_vente[score_risque_retour] < 70, "Moyen", "Élevé")
		dataType: string
		displayFolder: Colonnes calculées
		lineageTag: 8ca23f94-b80a-5be2-b97c-92d1bb21ff2d
		summarizeBy: none

