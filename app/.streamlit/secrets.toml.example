# Copiez ce fichier vers .streamlit/secrets.toml et renseignez vos propres valeurs.
# ⚠️ Ne commitez jamais le vrai fichier secrets.toml dans un dépôt Git public.

# --- Envoi d'e-mails (vérification de compte) ---
# Exemple avec Gmail : activez la validation en 2 étapes puis créez un
# "mot de passe d'application" sur https://myaccount.google.com/apppasswords
[smtp]
host = "smtp.gmail.com"
port = 587
user = "votre.compte@gmail.com"
password = "votre-mot-de-passe-application"
sender_name = "ShopPulse Portal"

# --- Assistant données (API Gemini) : interroge le fichier Excel du projet ---
# Créez une clé gratuite sur https://aistudio.google.com/apikey (aucune carte requise)
# GEMINI_API_KEY = "AIza..."

# --- Emplacement du fichier de données (optionnel) ---
# Par défaut, le chatbot et le module de prévision utilisent automatiquement
# donnees_ventes_ecommerce.xlsx à la racine du projet (voir utils/data_config.py).
# Ne définissez EXCEL_DATA_PATH que si vous voulez pointer vers un autre fichier.
# EXCEL_DATA_PATH = "C:/chemin/vers/un/autre/fichier.xlsx"
